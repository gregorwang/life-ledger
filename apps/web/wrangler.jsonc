{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "life-ledger-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "AUTH_PASSWORD",
      "AUTH_SESSION_SECRET"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "CORE",
      "service": "life-ledger-core"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "life-ledger-media"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
